rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Videos shared on Harvey's memorial site, each saved at the top level as
    // video-<32 hex digits>.<ext> (see lib/video.ts). Anyone can watch them
    // and add new ones (video files under 500 MB), but nobody can browse the
    // list, or change or delete what's there.
    match /{file} {
      allow get: if file.matches('video-[0-9a-f]{32}[.][a-z0-9]{2,4}');
      allow create: if resource == null
        && file.matches('video-[0-9a-f]{32}[.][a-z0-9]{2,4}')
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('video/.+');
    }
  }
}
